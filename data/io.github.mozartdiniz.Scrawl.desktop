[Desktop Entry]
Name=Scrawl
Comment=View and annotate images: arrows, shapes, text, highlights and crop
Exec=scrawl %F
Icon=io.github.mozartdiniz.Scrawl
Terminal=false
Type=Application
Categories=Graphics;Viewer;2DGraphics;GTK;GNOME;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;
Keywords=markup;annotate;screenshot;arrow;preview;
StartupNotify=true
