<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mozartdiniz.Scrawl</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Scrawl</name>
  <summary>View and annotate images</summary>
  <developer id="io.github.mozartdiniz">
    <name>Mozart Diniz</name>
  </developer>
  <description>
    <p>
      Scrawl brings the macOS Preview markup workflow to Linux: open an image
      or paste a screenshot, then annotate it and save or copy the result.
    </p>
    <ul>
      <li>Sketch rough shapes that snap to clean ones, or draw freehand</li>
      <li>Arrows, lines, rectangles, ovals, speech bubbles, stars and hexagons</li>
      <li>Rotatable text boxes, highlights and redactions</li>
      <li>Crop and adjust size with resolution control</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.mozartdiniz.Scrawl.desktop</launchable>
  <url type="homepage">https://github.com/mozartdiniz/scrawl</url>
  <url type="bugtracker">https://github.com/mozartdiniz/scrawl/issues</url>
  <url type="vcs-browser">https://github.com/mozartdiniz/scrawl</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/mozartdiniz/scrawl/main/docs/screenshot.png</image>
      <caption>Annotating an image</caption>
    </screenshot>
  </screenshots>
  <releases>
